{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adfpruebadk"
		},
		"AzureBlobStorageDL_connectionString": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"connectionString\"de \"AzureBlobStorageDL\"",
			"defaultValue": "DefaultEndpointsProtocol=https;AccountName=storagepruebadk;EndpointSuffix=core.windows.net;"
		},
		"AzureDatabricksConnect_accessToken": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accessToken\"de \"AzureDatabricksConnect\""
		},
		"AzureDatabricksConnect_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0915-010225-cxm96ug2"
		},
		"AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://tblkeyvault.vault.azure.net/"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "srv-pruebadk.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-dwhfinbank"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "DK_administrador"
		},
		"SqlServerlocalhost_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"SqlServerlocalhost_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_FinBank"
		},
		"SqlServerlocalhost_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pip_control_carga')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data control carga",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"sink": {
								"type": "AzureSqlSink",
								"preCopyScript": "truncate table stage.Tbl_tmp_ControlCarga;",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"name": "esquema_origen",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "esquema_origen",
											"type": "String",
											"physicalType": "nvarchar"
										}
									},
									{
										"source": {
											"name": "nombre_tabla_origen",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "nombre_tabla_origen",
											"type": "String",
											"physicalType": "nvarchar"
										}
									},
									{
										"source": {
											"name": "ruta_destino",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "ruta_destino",
											"type": "String",
											"physicalType": "nvarchar"
										}
									},
									{
										"source": {
											"name": "carpeta_destino",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "carpeta_destino",
											"type": "String",
											"physicalType": "nvarchar"
										}
									},
									{
										"source": {
											"name": "nombre_archivo_destino",
											"type": "String",
											"physicalType": "String"
										},
										"sink": {
											"name": "nombre_archivo_destino",
											"type": "String",
											"physicalType": "nvarchar"
										}
									}
								],
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "DelimitedText1",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "AzureSqlTable",
								"type": "DatasetReference",
								"parameters": {}
							}
						]
					},
					{
						"name": "Ejecuta insercion de datos",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "Copy data control carga",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "AzureSqlDatabase1",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "MERGE dbo.TablaControlCarga AS T\nUSING stage.Tbl_tmp_ControlCarga AS S\nON T.esquema_origen = S.esquema_origen\n   AND T.nombre_tabla_origen = S.nombre_tabla_origen\n\n when matched AND (\n T.ruta_destino <> S.ruta_destino or\n T.carpeta_destino <> S.carpeta_destino or\n T.nombre_archivo_destino <> S.nombre_archivo_destino\n ) then\n\n  update set    \n      ruta_destino = S.ruta_destino\n      ,carpeta_destino = S.carpeta_destino\n      ,nombre_archivo_destino = S.nombre_archivo_destino\n      ,fecha_actualizacion = getdate()\n\nWHEN NOT MATCHED BY TARGET THEN\n    INSERT (esquema_origen,\n            nombre_tabla_origen,\n            ruta_destino,\n            carpeta_destino,\n            nombre_archivo_destino,\n            estado_proceso,\n        consulta,\n            fecha_actualizacion)\n    VALUES (S.esquema_origen,\n            S.nombre_tabla_origen,\n            S.ruta_destino,\n            S.carpeta_destino,\n            S.nombre_archivo_destino,\n            'activo',\n            'select * from',\n            GETDATE());\n\ntruncate table [stage].[Tbl_tmp_ControlCarga];"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DelimitedText1')]",
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable')]",
				"[concat(variables('factoryId'), '/linkedServices/AzureSqlDatabase1')]"
			]
		},
		{
