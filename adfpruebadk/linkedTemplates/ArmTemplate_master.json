{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adfpruebadk"
		},
		"AzureBlobStorageDL_connectionString": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"connectionString\"de \"AzureBlobStorageDL\"",
			"defaultValue": "DefaultEndpointsProtocol=https;AccountName=storagepruebadk;EndpointSuffix=core.windows.net;"
		},
		"AzureDatabricksConnect_accessToken": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accessToken\"de \"AzureDatabricksConnect\""
		},
		"AzureDatabricksConnect_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "0915-010225-cxm96ug2"
		},
		"AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://tblkeyvault.vault.azure.net/"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "srv-pruebadk.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-dwhfinbank"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "DK_administrador"
		},
		"SqlServerlocalhost_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"SqlServerlocalhost_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_FinBank"
		},
		"SqlServerlocalhost_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI de la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas."
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Token de SAS para la cuenta de almacenamiento que contiene las plantillas de ARM vinculadas"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfpruebadk_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDatabricksConnect_accessToken": {
						"value": "[parameters('AzureDatabricksConnect_accessToken')]"
					},
					"AzureBlobStorageDL_connectionString": {
						"value": "[parameters('AzureBlobStorageDL_connectionString')]"
					},
					"AzureDatabricksConnect_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricksConnect_properties_typeProperties_existingClusterId')]"
					},
					"AzureKeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault_properties_typeProperties_baseUrl')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"SqlServerlocalhost_properties_typeProperties_server": {
						"value": "[parameters('SqlServerlocalhost_properties_typeProperties_server')]"
					},
					"SqlServerlocalhost_properties_typeProperties_database": {
						"value": "[parameters('SqlServerlocalhost_properties_typeProperties_database')]"
					},
					"SqlServerlocalhost_properties_typeProperties_userName": {
						"value": "[parameters('SqlServerlocalhost_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}