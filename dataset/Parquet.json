{
	"name": "Parquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureBlobStorageDL",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"Nombre_archivo": {
				"type": "string"
			},
			"Ruta_destino": {
				"type": "string"
			},
			"Carpeta_destino": {
				"type": "string"
			},
			"contenedor": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().Nombre_archivo",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().Ruta_destino",
					"type": "Expression"
				},
				"container": {
					"value": "@dataset().contenedor",
					"type": "Expression"
				}
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}