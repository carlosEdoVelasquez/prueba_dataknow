{
	"name": "pip_control_carga",
	"properties": {
		"activities": [
			{
				"name": "Copy data control carga",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": "truncate table stage.Tbl_tmp_ControlCarga;",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "esquema_origen",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "esquema_origen",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "nombre_tabla_origen",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "nombre_tabla_origen",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "ruta_destino",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "ruta_destino",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "carpeta_destino",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "carpeta_destino",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "nombre_archivo_destino",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "nombre_archivo_destino",
									"type": "String",
									"physicalType": "nvarchar"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "AzureSqlTable",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Ejecuta insercion de datos",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy data control carga",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "MERGE dbo.TablaControlCarga AS T\nUSING stage.Tbl_tmp_ControlCarga AS S\nON T.esquema_origen = S.esquema_origen\n   AND T.nombre_tabla_origen = S.nombre_tabla_origen\n\n when matched AND (\n T.ruta_destino <> S.ruta_destino or\n T.carpeta_destino <> S.carpeta_destino or\n T.nombre_archivo_destino <> S.nombre_archivo_destino\n ) then\n\n  update set    \n      ruta_destino = S.ruta_destino\n      ,carpeta_destino = S.carpeta_destino\n      ,nombre_archivo_destino = S.nombre_archivo_destino\n      ,fecha_actualizacion = getdate()\n\nWHEN NOT MATCHED BY TARGET THEN\n    INSERT (esquema_origen,\n            nombre_tabla_origen,\n            ruta_destino,\n            carpeta_destino,\n            nombre_archivo_destino,\n            estado_proceso,\n        consulta,\n            fecha_actualizacion)\n    VALUES (S.esquema_origen,\n            S.nombre_tabla_origen,\n            S.ruta_destino,\n            S.carpeta_destino,\n            S.nombre_archivo_destino,\n            'activo',\n            'select * from',\n            GETDATE());\n\ntruncate table [stage].[Tbl_tmp_ControlCarga];"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"annotations": []
	}
}