									"name": "ruta_destino",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "carpeta_destino",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "carpeta_destino",
									"type": "String",
									"physicalType": "nvarchar"
								}
							},
							{
								"source": {
									"name": "nombre_archivo_destino",
									"type": "String",
									"physicalType": "String"
								},
								"sink": {
									"name": "nombre_archivo_destino",
									"type": "String",
									"physicalType": "nvarchar"
