{
	"name": "pip_orquestacion",
	"properties": {
		"activities": [
			{
				"name": "Lookup control cargas",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select * from [dbo].[TablaControlCarga]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach carga archivos bronze",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Set variable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup control cargas').output.value",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Copy data tablas",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "SqlServerSource",
									"sqlReaderQuery": {
										"value": "@concat(item().consulta,' ',variables('listarTablas'))",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "SqlServerTable1",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "Parquet",
									"type": "DatasetReference",
									"parameters": {
										"Nombre_archivo": {
											"value": "@concat(item().nombre_archivo_destino,'_',variables('fecha_actual'))",
											"type": "Expression"
										},
										"Ruta_destino": {
											"value": "@item().ruta_destino",
											"type": "Expression"
										},
										"Carpeta_destino": {
											"value": "@item().carpeta_destino",
											"type": "Expression"
										},
										"contenedor": "bronze"
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "LookupListarTablas",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Lookup control cargas",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select TABLE_SCHEMA, TABLE_NAME\nfrom INFORMATION_SCHEMA.TABLES",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "SqlServerTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set variable",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set variable calcular fecha",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "listarTablas",
					"value": {
						"value": "@concat(last(activity('LookupListarTablas').output.value).TABLE_SCHEMA,'.',last(activity('LookupListarTablas').output.value).TABLE_NAME)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable calcular fecha",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "LookupListarTablas",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "fecha_actual",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyyMMdd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Crear_tablas",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "ForEach carga archivos bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Prueba_Dataknow/notebooks/00_creacion_estructura"
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricksConnect",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "crear reglas calidad de datos",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Crear_tablas",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Prueba_Dataknow/notebooks/01_calidad_datos"
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricksConnect",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Bronze to silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "crear reglas calidad de datos",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Prueba_Dataknow/notebooks/02_bronze_to_silver"
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricksConnect",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Silver to gold",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Bronze to silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Prueba_Dataknow/notebooks/03_silver_to_gold"
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabricksConnect",
					"type": "LinkedServiceReference"
				}
			}
		],
		"variables": {
			"listarTablas": {
				"type": "String"
			},
			"fecha_actual": {
				"type": "String"
			}
		},
		"annotations": []
	}
}